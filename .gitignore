# KiCad backup/autosave
*.kicad_prl
*-backups/
_autosave-*
*.bak
*~

# JLCPCB fab packages (regenerated via make jlc)
hardware/*/jlcpcb/
hardware/*/*-jlcpcb.zip

# Generated SVGs (regenerated via make docs)
hardware/*/docs/images/*.svg

# ESPHome build artifacts
firmware/**/.esphome/

# Build outputs
firmware/build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Python bytecode from hardware/scripts generators
__pycache__/
*.pyc
